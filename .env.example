# Names only, never values. Real values live in Vercel: Project "portfolio" -> Settings -> Environment Variables.
# Never commit a real .env file; .gitignore already blocks them.

# PostHog analytics (docs/analytics.md). The key is the public phc_ project token, safe in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Always /ingest: the app proxies analytics through its own origin (next.config.ts rewrites).
NEXT_PUBLIC_POSTHOG_HOST=/ingest
